# ═══════════════════════════════════════════════════════════
#  Meridian — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Wallet (required) ────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ─── Solana RPC (required) ────────────────────────────────
# Helius recommended for reliability and DAS API support
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_API_KEY=your_helius_api_key

# ─── LLM Providers ───────────────────────────────────────
# Global default provider. Per-role overrides in user-config.json.
# Options: "openrouter" (default), "minimax", "openai", "deepseek"
LLM_PROVIDER=openrouter

# Set API keys for providers you use:
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
MINIMAX_API_KEY=                          # From platform.minimax.io
OPENAI_API_KEY=sk-xxxxxxxxxxxx            # For Codex screening or direct OpenAI
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx          # For DeepSeek direct

# ─── Jupiter API (optional) ──────────────────────────────
# For token swaps. Get from https://portal.jup.ag
JUPITER_API_KEY=your_jupiter_api_key

# ─── LP Agent API (optional) ─────────────────────────────
# For top LPer study and verified on-chain PnL data.
# Comma-separated keys for automatic rotation on rate limits.
LPAGENT_API_KEY=key1,key2,key3

# ─── Telegram (optional) ─────────────────────────────────
# Bot token from @BotFather for notifications and remote commands.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─── Dry Run ─────────────────────────────────────────────
# Set to "true" to simulate all transactions without on-chain execution.
DRY_RUN=false

# ─── Web Dashboard ───────────────────────────────────────
# Bearer token for API + WebSocket auth. When unset, dashboard
# runs without auth (fine if only accessed via SSH tunnel).
# Generate with: openssl rand -hex 32
# WEB_AUTH_TOKEN=
